{
  "name": "chatapp",
  "version": "1.0.0",
  "description": "Real-time chat application with React frontend and .NET backend",
  "private": true,
  "scripts": {
    "dev": "cd Frontend && npm run dev",
    "build": "cd Frontend && npm run build",
    "preview": "cd Frontend && npm run preview",
    "lint": "cd Frontend && npm run lint",
    "backend:setup": "cd Backend/ChatBackend && dotnet restore",
    "backend:run": "cd Backend/ChatBackend && dotnet run",
    "backend:build": "cd Backend/ChatBackend && dotnet build"
  },
  "keywords": [
    "chat",
    "realtime",
    "react",
    "dotnet",
    "signalr"
  ],
